# Required
JHE_BASE_URL="http://localhost:8000"
JHE_CLIENT_ID="<OAuth client id registered in JHE for the MCP broker>"
JHE_CLIENT_SECRET="<OAuth client secret registered in JHE for the MCP broker>"
MCP_BROKER_KEY="Required to run the OAuth broker. `openssl rand -base64 32`"


# Optional - defaults shown
JHE_REDIRECT_URI="http://localhost:8765/callback"
JHE_AUTHORIZE_ENDPOINT="${JHE_BASE_URL}/o/authorize/"
JHE_TOKEN_ENDPOINT="${JHE_BASE_URL}/o/token/"
JHE_USERINFO_ENDPOINT="${JHE_BASE_URL}/o/userinfo/"
MCP_RESOURCE_URL="http://localhost:8401"
MCP_ALLOWED_REDIRECTS=""
MCP_REQUIRE_AUDIENCE="false"
MCP_HTTP_PORT="8401"
